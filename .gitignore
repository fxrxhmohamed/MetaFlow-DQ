# Data: source files and every pipeline output (raw, validated,
# quarantine, corrected, quality, final, metrics, profiling) stay local.
# Anchored to the project root, so tests/data/ (the CI test dataset) is kept.
/data/

# Correction files downloaded or exported into the project root
# (python dq.py export-template --output fixes.csv, UI downloads)
/*.csv
/*.xlsx

# Local copies of the git repository (e.g. MetaFlow-DQ-backup.git)
/*.git/

