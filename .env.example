# Landing zone shared by ingestion, metadata (profiler) and loading services
LANDING_ROOT=./data/landing
PROFILE_REPORTS_ROOT=./data/reports/profiling
INGEST_YEARS=2024,2025,2026

# Snowflake (loading-service and dbt)
SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
SNOWFLAKE_USER=METAFLOW_SVC
SNOWFLAKE_PASSWORD=
# or key-pair auth instead of a password
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=METAFLOW_ROLE
SNOWFLAKE_WAREHOUSE=METAFLOW_WH
SNOWFLAKE_DATABASE=METAFLOW_DQ
